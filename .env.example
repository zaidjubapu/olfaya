# AI for the concierge (Aya) and Scent DNA. Gemini is used when its key is set,
# otherwise Claude if ANTHROPIC_API_KEY is set, otherwise the built-in offline matcher.
GEMINI_API_KEY=
# Optional: pin a Gemini model (default gemini-flash-latest)
GEMINI_MODEL=
ANTHROPIC_API_KEY=
# Optional: override the Claude model (default claude-opus-5-5)
OLFAYA_MODEL=

# Public site URL used for SEO/OG tags
NEXT_PUBLIC_SITE_URL=https://olfaya.com

# Optional: Razorpay for online payments (INR UPI/cards, AED/SAR cards)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Optional: where new orders and newsletter sign-ups are sent (Slack, Zapier, Google Apps Script)
ORDER_WEBHOOK_URL=
SUBSCRIBE_WEBHOOK_URL=
