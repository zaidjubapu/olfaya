# Claude API key for the AI concierge (Aya) and Scent DNA. Without it the site
# falls back to the built-in offline matcher, so it still works.
ANTHROPIC_API_KEY=
# Optional: override the model (default claude-opus-5-5)
OLFAYA_MODEL=

# Public site URL used for SEO/OG tags
NEXT_PUBLIC_SITE_URL=https://olfaya.com

# Optional: Razorpay for online payments (INR UPI/cards, AED/SAR cards)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Optional: where new orders and newsletter sign-ups are sent (Slack, Zapier, Google Apps Script)
ORDER_WEBHOOK_URL=
SUBSCRIBE_WEBHOOK_URL=
